# RakazaTokenization: .env.example  (names only; copy to .env.local and fill in)
# Only NEXT_PUBLIC_* reaches the browser. Everything else is server-only.
# Mirror of research/ENV-VARS.md. Every name below has a concrete use.

# ---- Public / non-secret ----
NEXT_PUBLIC_APP_URL=http://localhost:3200      # canonical URL (links, OG, cookies)
NEXT_PUBLIC_SOLANA_NETWORK=devnet              # devnet | mainnet-beta
NEXT_PUBLIC_TREASURY_PUBKEY=                   # treasury public key (30% fee share, shown on Vault + Contract)
TREASURY_PUBKEY=                               # same value, server-side alias
NEXT_PUBLIC_TOKEN_MINT=                        # our coin's mint after launch (Home CA pill)
NEXT_PUBLIC_JUPITER_PUBLISHABLE_KEY=           # browser-safe Jupiter plugin key (alias JUPITER_PUBLISHABLE_KEY)
NEXT_PUBLIC_X_URL=                             # optional: shows the X icon in the header
NEXT_PUBLIC_TELEGRAM_URL=                      # optional: shows the Telegram icon in the header

# ---- Safety gates ----
# EXECUTE_ENABLED must be exactly "true" for ANY signature or send. Leave UNSET.
EXECUTE_ENABLED=
SPONSORED_ENABLED=false                        # sponsored launches (fee payer = treasury) off by default
MAX_LAUNCH_SOL=0.5                             # per-launch spend cap
MAX_DAILY_SPEND_SOL=1                          # daily spend cap
DEV_PREVIEW_OWNER_PAGES=false                  # dev only: view owner stub pages without a session. Ignored in production.

# ---- Generated secrets (>= 32 chars; make with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))") ----
SESSION_SECRET=                                # signs the owner session cookie
CRON_SECRET=                                   # authorises Vercel cron routes
LIVE_SECRET=                                   # signs live-queue tickets
TREASURY_ENCRYPTION_KEY=                       # optional AES-GCM key if the treasury key is stored encrypted

# ---- Owner / agent auth ----
DASHBOARD_PASSWORD=                            # owner login at /login
API_SERVER_KEY=                                # bearer key for agents on /mcp and /api/v1/*

# ---- Solana RPC and market data ----
HELIUS_MAINNET=                                # RPC (mainnet) via allow-listed /api/rpc proxy
HELIUS_DEVNET=                                 # RPC (devnet)
PIMLICO_API_KEY=                               # secondary RPC / sponsorship path
JUPITER_API_KEY=                               # api.jup.ag tokens, price, swap
SOLANATRACKER_API_KEY=                         # holders, bundlers, snipers

# ---- Storage / cache ----
PINATA_API_KEY=                                # IPFS pinning (metadata + memes)
PINATA_API_SECRET=
PINATA_JWT=                                    # optional alternative to key+secret
UPSTASH_REST_URL=                              # Redis REST (alias UPSTASH_REDIS_REST_URL)
UPSTASH_REST_TOKEN=                            # read/write (alias UPSTASH_REDIS_REST_TOKEN)
UPSTASH_READONLY_TOKEN=                        # read-only, for public GET routes
DATABASE_URL=                                  # optional Neon Postgres for ledgers

# ---- AI / voice ----
RIVER_BASE_URL=https://api.river.ai/v1         # OpenAI-compatible
RIVER_AGENT=                                   # operator agent key
RIVER_RAKAZO=                                  # public persona key (separate quota)
RIVER_MODEL_AGENT=                             # chosen from /models
RIVER_MODEL_PERSONA=
NEON_AI_GATEWAY_TOKEN=                         # fallback LLM gateway
NEON_AI_GATEWAY_BASE_URL=                      # needed for the fallback (not yet known)
DEEPGRAM_API_KEY=                              # STT/TTS; only used server-side to mint short-lived tokens
BRAVE_SEARCH_API_KEY=                          # agent web_search tool
FIRECRAWL_API_KEY=                             # agent scrape_url tool

# ---- Ops ----
UPCLOUD_API_TOKEN=                             # /infra read-only server status

# ---- NOT in app env on purpose ----
# TREASURY_PRIVATE_KEY   Only added in Phase 6 as a Secret, decrypted in memory behind the approval gate.
# VERCEL_TOKEN           Builder tooling only. Never a runtime env var.

# --- Reserved for later phases (no app-level env var) ---
# Paybox (https://app.paybox.sh/?return=%2Fplugins): each USER connects their own Paybox key at
# /settings/integrations (Phase 7). It is stored encrypted per user with TREASURY_ENCRYPTION_KEY-style
# envelope encryption and never shown again. Nothing to set here.
# Per-user agent keys (/agents, /register, /skill.md, Phase 5) are generated per user and stored hashed.

# Token image generation (Pollinations, FLUX)
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux
