# Rakaza AI Terminal: .env.example  (NAMES ONLY. Copy to .env.local and fill in. Never commit real values.)
# Only NEXT_PUBLIC_* reaches the browser. Everything else is server-only.
# The app builds and serves public pages with NONE of these set; each missing key shows "missing"
# in Dashboard > Integrations health and the matching feature answers "not configured" (503).
# Full table with signup links: README.md#environment-variables

# ======================= REQUIRED to log in / run the owner side =======================
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"  (32+ chars, all different)
SESSION_SECRET=                                # signs the owner session cookie + approval tickets + sealed mint keys
CRON_SECRET=                                   # Vercel cron sends it as a Bearer token
LIVE_SECRET=                                   # signs live-queue tickets
DASHBOARD_PASSWORD=                            # owner login at /login (choose a strong one)
API_SERVER_KEY=                                # 16+ chars. Bearer key for owner/agents on /mcp, /api/v1/*, /api/telegram/setup

# ======================= REQUIRED to launch coins =======================
HELIUS_DEVNET=                                 # RPC (devnet).  Get: https://www.helius.dev/  (dashboard > API keys)
HELIUS_MAINNET=                                # RPC (mainnet). Same account
TREASURY_PUBKEY=                               # PUBLIC key of the platform wallet (30% share of sponsored launches + the self-launch service fee)
TREASURY_PRIVATE_KEY=                          # SECRET signer (base58 or JSON array). Devnet key first. Used only behind EXECUTE_ENABLED + approval
PINATA_API_KEY=                                # IPFS metadata pinning. Get: https://pinata.cloud/ (API keys)
PINATA_API_SECRET=
PINATA_JWT=                                    # optional alternative to key + secret

# ======================= Network, links, safety gates =======================
NEXT_PUBLIC_APP_URL=http://localhost:3200      # canonical URL (links, OG, cookies). Set to your domain in production
NEXT_PUBLIC_SOLANA_NETWORK=devnet              # devnet | mainnet-beta
NEXT_PUBLIC_TREASURY_PUBKEY=                   # same public key as TREASURY_PUBKEY (shown on Vault)
NEXT_PUBLIC_TOKEN_MINT=                        # your own coin's mint after launch (Home CA pill)
NEXT_PUBLIC_X_URL=                             # optional: X icon in the header
NEXT_PUBLIC_TELEGRAM_URL=                      # optional: Telegram icon in the header
EXECUTE_ENABLED=                               # must be exactly "true" for ANY signature/send. Leave UNSET until the mainnet checklist
SELF_LAUNCH_ENABLED=                           # optional: public /self-launch (user wallet pays). Default ON on devnet; set true to allow on mainnet, false to disable
SELF_LAUNCH_SERVICE_FEE_USD=2                    # flat service fee for self launches, in USD, paid in SOL inside the launch transaction (no fee share)
SELF_LAUNCH_SERVICE_FEE_SOL=0.015               # fallback in SOL used only if the Jupiter price lookup fails
SPONSORED_ENABLED=false                        # sponsored launches (treasury pays fees) off by default
MAX_LAUNCH_SOL=0.5                             # per-launch spend cap
MAX_DAILY_SPEND_SOL=1                          # daily spend cap
DEV_PREVIEW_OWNER_PAGES=false                  # LOCAL DEV ONLY: view owner pages without a session. Ignored in production
TREASURY_ENCRYPTION_KEY=                       # optional 32+ char AES-GCM key if a treasury key is stored encrypted

# ======================= Storage and cache =======================
DATABASE_URL=                                  # Neon Postgres (ledgers, registration, history). Get: https://neon.tech/
UPSTASH_REDIS_REST_URL=                        # Redis REST (approvals, rate limits, Telegram taps). Get: https://upstash.com/
UPSTASH_REDIS_REST_TOKEN=                      # read/write token
UPSTASH_READONLY_TOKEN=                        # read-only token for public GET routes
# Legacy aliases still accepted: UPSTASH_REST_URL, UPSTASH_REST_TOKEN

# ======================= Market data =======================
JUPITER_API_KEY=                               # prices, quotes. Get: https://portal.jup.ag/
NEXT_PUBLIC_JUPITER_PUBLISHABLE_KEY=           # browser-safe Jupiter key (alias JUPITER_PUBLISHABLE_KEY)
SOLANATRACKER_API_KEY=                         # holders, bundlers, snipers. Get: https://www.solanatracker.io/
PIMLICO_API_KEY=                               # secondary RPC / sponsorship. Get: https://www.pimlico.io/

# ======================= AI and voice =======================
RIVER_BASE_URL=https://api.river.ai/v1         # OpenAI-compatible endpoint
RIVER_AGENT=                                   # operator agent key (River AI dashboard)
RIVER_RAKAZO=                                  # public persona key (separate quota)
RIVER_MODEL_AGENT=                             # model ids, chosen from /models
RIVER_MODEL_PERSONA=
NEON_AI_GATEWAY_TOKEN=                         # optional fallback LLM gateway
NEON_AI_GATEWAY_BASE_URL=
DEEPGRAM_API_KEY=                              # speech in/out; only used server-side to mint short-lived tokens. Get: https://deepgram.com/
# RAKAZA_VOICE=aura-2-luna-en                  # optional voice (also aura-2-selene-en, aura-2-hera-en, aura-2-cora-en)
POLLINATIONS_API_KEY=                          # FLUX images for Studio and launches. Get: https://gen.pollinations.ai/docs
POLLINATIONS_IMAGE_MODEL=flux
BRAVE_SEARCH_API_KEY=                          # agent web_search tool. Get: https://brave.com/search/api/
FIRECRAWL_API_KEY=                             # agent scrape_url tool. Get: https://www.firecrawl.dev/

# ======================= Ops and Telegram =======================
UPCLOUD_API_TOKEN=                             # /infra read-only server status. Get: https://upcloud.com/
TELEGRAM_BOT_TOKEN=                            # create with @BotFather (https://t.me/BotFather)
TELEGRAM_ADMIN_ID=                             # your numeric Telegram user id (ask @userinfobot). The bot obeys only this id

# ======================= Tests only (never set in production) =======================
# TELEGRAM_MOCK=1                              # record Telegram sends in memory (tests/telegram-sim.ts)
# BASE=http://localhost:3200                   # target for tests/*.mjs

# NOT app env on purpose: VERCEL_TOKEN (builder tooling only), any wallet keypair file.
